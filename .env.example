NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_ENABLED=true
AI_MAX_REQUESTS_PER_MINUTE=5
AI_MAX_REQUESTS_PER_DAY=200
AI_MAX_TOOL_CALLS_PER_REQUEST=6
AI_MAX_OUTPUT_TOKENS=2048
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET=
CLIMATIQ_API_KEY=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_SCOPES=
# Sentry error monitoring — NEXT_PUBLIC_SENTRY_DSN is required for capture to
# do anything at all (client, server, and edge all read this one value); the
# other three are optional and only used at build time to upload source maps
# so stack traces show real file/line info instead of minified code.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
